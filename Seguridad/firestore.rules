rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════
    // FUNCIONES AUXILIARES
    // ════════════════════════════════════════════════════════════

    // ¿El usuario está autenticado (cualquier método incluyendo anónimo)?
    function isAuth() {
      return request.auth != null;
    }

    // ¿El usuario tiene documento activo en users identificado por su UID?
    // (se registra el UID al primer login exitoso con PIN)
    function isAirtechassistUser() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/airtechassist/config/users/$(request.auth.uid));
    }

    // ¿Es superadmin? — UID leído del documento /airtechassist/config (no hardcodeado)
    function isSuperAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/airtechassist/config) &&
        get(/databases/$(database)/documents/airtechassist/config).data.superadmin
          == request.auth.uid;
    }

    // ¿Es admin o superior?
    function isAdmin() {
      return isAirtechassistUser() &&
        get(/databases/$(database)/documents/airtechassist/config/users/$(request.auth.uid)).data.role
          in ['superadmin', 'supervisor', 'admin'];
    }

    // ════════════════════════════════════════════════════════════
    // DOCUMENTO RAÍZ DE CONFIG — /airtechassist/config
    // Contiene el campo superadminUid (y otros settings globales).
    // Cualquier auth puede leerlo (las reglas lo necesitan).
    // Escribir solo desde Firebase Console / Admin SDK.
    // ════════════════════════════════════════════════════════════
    match /airtechassist/config {
      allow read:  if isAuth();
      allow write: if false;
    }

    // ════════════════════════════════════════════════════════════
    // USUARIOS
    // list: cualquier auth puede listar (necesario para login con PIN)
    // get:  usuario registrado o el propio documento
    // update: superadmin O el propio usuario actualizando solo su uid/lastLogin
    // ════════════════════════════════════════════════════════════
    match /airtechassist/config/users/{userId} {
      allow list:   if isAuth();
      allow get:    if isAirtechassistUser() || isSuperAdmin() ||
                       (isAuth() && userId == request.auth.uid);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
                       (isAuth() && userId == request.auth.uid &&
                        request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['uid', 'lastLogin']));
      allow delete: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // CONFIGURACIÓN — estaciones, catálogo, etc.
    // stations y aircraft: lectura con auth (necesaria antes del login)
    // appConfig ya tiene su propio match arriba
    // ════════════════════════════════════════════════════════════
    match /airtechassist/config/stations/{id} {
      allow read:  if isAuth();
      allow write: if isSuperAdmin();
    }
    match /airtechassist/config/aircraft/{id} {
      allow read:  if isAuth();
      allow write: if isSuperAdmin();
    }
    match /airtechassist/config/{collection}/{id} {
      allow read:  if isAirtechassistUser() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // AUDIT LOG
    // ════════════════════════════════════════════════════════════
    match /airtechassist/audit/logs/{id} {
      allow create: if isAirtechassistUser() || isSuperAdmin();
      allow read:   if isSuperAdmin();
      allow update, delete: if false;
    }

    // ════════════════════════════════════════════════════════════
    // REPORTES — create anónimo permitido (reporte de piloto)
    // ════════════════════════════════════════════════════════════
    match /airtechassist/{station}/reports/{id} {
      allow create: if isAuth();
      allow read:   if isAirtechassistUser() || isSuperAdmin();
      allow update: if isAirtechassistUser() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // TAREAS (OTs)
    // ════════════════════════════════════════════════════════════
    match /airtechassist/{station}/tasks/{id} {
      allow read:   if isAirtechassistUser() || isSuperAdmin();
      allow create: if isAdmin() || isSuperAdmin();
      allow update: if isAirtechassistUser() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // TÉCNICOS
    // ════════════════════════════════════════════════════════════
    match /airtechassist/{station}/techs/{id} {
      allow read:  if isAirtechassistUser() || isSuperAdmin();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // PLANIFICACIÓN
    // ════════════════════════════════════════════════════════════
    match /airtechassist/{station}/plans/{id} {
      allow read:   if isAirtechassistUser() || isSuperAdmin();
      allow create: if isAdmin() || isSuperAdmin();
      allow update: if isAirtechassistUser() || isSuperAdmin();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // HORARIOS
    // ════════════════════════════════════════════════════════════
    match /airtechassist/{station}/schedules/{id} {
      allow read:  if isAirtechassistUser() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // VUELOS
    // ════════════════════════════════════════════════════════════
    match /airtechassist/{station}/flights/{id} {
      allow read:   if isAirtechassistUser() || isSuperAdmin();
      allow create: if isAdmin() || isSuperAdmin();
      allow update: if isAirtechassistUser() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // CONFIG POR ESTACIÓN (notificaciones, etc.)
    // ════════════════════════════════════════════════════════════
    match /airtechassist/{station}/config/{id} {
      allow read:  if isAirtechassistUser() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // HISTORIAL Y DOCUMENTOS
    // ════════════════════════════════════════════════════════════
    match /airtechassist/{station}/history/{id} {
      allow read, write: if isAirtechassistUser() || isSuperAdmin();
    }

    match /airtechassist/{station}/documents/{id} {
      allow read, write: if isAirtechassistUser() || isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // BLOQUEO TOTAL — cualquier otra ruta: DENEGADA
    // ════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
