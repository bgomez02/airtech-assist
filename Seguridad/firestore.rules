rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════
    // FUNCIONES AUXILIARES — TENANT ORIGINAL (airtechassist)
    // ════════════════════════════════════════════════════════════

    function isAuth() {
      return request.auth != null;
    }

    function isAirtechassistUser() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/airtechassist/config/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/airtechassist/config) &&
        get(/databases/$(database)/documents/airtechassist/config).data.superadmin
          == request.auth.uid;
    }

    function isAdmin() {
      return isAirtechassistUser() &&
        get(/databases/$(database)/documents/airtechassist/config/users/$(request.auth.uid)).data.role
          in ['superadmin', 'supervisor', 'admin'];
    }

    // ════════════════════════════════════════════════════════════
    // FUNCIONES AUXILIARES — MULTI-TENANT (nuevos clientes)
    // ════════════════════════════════════════════════════════════

    function getClientId(uid) {
      return get(/databases/$(database)/documents/registry/$(uid)).data.clientId;
    }

    function isMember(clientId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/registry/$(request.auth.uid)) &&
        getClientId(request.auth.uid) == clientId;
    }

    function isMemberAdmin(clientId) {
      return isMember(clientId) &&
        get(/databases/$(database)/documents/$(clientId)/config/users/$(request.auth.uid)).data.role
          in ['superadmin', 'admin', 'supervisor'];
    }

    // ════════════════════════════════════════════════════════════
    // DIRECTORIO CENTRAL DE CLIENTES — solo plataforma admin
    // ════════════════════════════════════════════════════════════
    match /platform/clients/list/{clientId} {
      allow read:   if isSuperAdmin();
      allow create: if request.auth != null;
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════
    // REGISTRO GLOBAL — uid → clientId
    // ════════════════════════════════════════════════════════════
    match /registry/{uid} {
      allow read:   if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['clientId'])
                    && request.resource.data.clientId is string;
      allow update, delete: if false;
    }

    // ════════════════════════════════════════════════════════════
    // TENANT ORIGINAL — /airtechassist/...
    // ════════════════════════════════════════════════════════════

    match /airtechassist/config {
      allow read:  if isAuth();
      allow write: if false;
    }

    match /airtechassist/config/users/{userId} {
      allow list:   if isAuth();
      allow get:    if isAirtechassistUser() || isSuperAdmin() ||
                       (isAuth() && userId == request.auth.uid);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
                       (isAuth() && userId == request.auth.uid &&
                        request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['uid', 'lastLogin']));
      allow delete: if isSuperAdmin();
    }

    match /airtechassist/config/stations/{id} {
      allow read:  if isAuth();
      allow write: if isSuperAdmin();
    }
    match /airtechassist/config/aircraft/{id} {
      allow read:  if isAuth();
      allow write: if isSuperAdmin();
    }
    match /airtechassist/config/{collection}/{id} {
      allow read:  if isAirtechassistUser() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /airtechassist/audit/logs/{id} {
      allow create: if isAirtechassistUser() || isSuperAdmin();
      allow read:   if isSuperAdmin();
      allow update, delete: if false;
    }

    match /airtechassist/{station}/reports/{id} {
      allow create: if isAuth();
      allow read:   if isAirtechassistUser() || isSuperAdmin();
      allow update: if isAirtechassistUser() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /airtechassist/{station}/tasks/{id} {
      allow read:   if isAirtechassistUser() || isSuperAdmin();
      allow create: if isAdmin() || isSuperAdmin();
      allow update: if isAirtechassistUser() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /airtechassist/{station}/techs/{id} {
      allow read:  if isAirtechassistUser() || isSuperAdmin();
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /airtechassist/{station}/plans/{id} {
      allow read:   if isAirtechassistUser() || isSuperAdmin();
      allow create: if isAdmin() || isSuperAdmin();
      allow update: if isAirtechassistUser() || isSuperAdmin();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    match /airtechassist/{station}/schedules/{id} {
      allow read:  if isAirtechassistUser() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /airtechassist/{station}/flights/{id} {
      allow read:   if isAirtechassistUser() || isSuperAdmin();
      allow create: if isAdmin() || isSuperAdmin();
      allow update: if isAirtechassistUser() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /airtechassist/{station}/config/{id} {
      allow read:  if isAirtechassistUser() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /airtechassist/{station}/history/{id} {
      allow read, write: if isAirtechassistUser() || isSuperAdmin();
    }

    match /airtechassist/{station}/documents/{id} {
      allow read, write: if isAirtechassistUser() || isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // CLIENTES MULTI-TENANT — /{clientId}/...
    // Aplica a cualquier colección que no sea airtechassist ni registry
    // ════════════════════════════════════════════════════════════

    match /{clientId}/config {
      allow read:   if isMember(clientId) || isSuperAdmin();
      allow create: if isMember(clientId);
      allow update: if isMemberAdmin(clientId) || isSuperAdmin();
      allow delete: if false;
    }

    match /{clientId}/config/users/{userId} {
      allow list:   if isMember(clientId) || isSuperAdmin();
      allow get:    if isMember(clientId) || isSuperAdmin();
      allow create: if request.auth != null && userId == request.auth.uid;
      allow update: if isMemberAdmin(clientId) || isSuperAdmin() ||
                       (isMember(clientId) && userId == request.auth.uid &&
                        request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['uid', 'lastLogin']));
      allow delete: if isMemberAdmin(clientId) || isSuperAdmin();
    }

    match /{clientId}/config/stations/{id} {
      allow read:  if isMember(clientId) || isSuperAdmin();
      allow write: if isMemberAdmin(clientId) || isSuperAdmin();
    }

    match /{clientId}/config/aircraft/{id} {
      allow read:  if isMember(clientId) || isSuperAdmin();
      allow write: if isMemberAdmin(clientId) || isSuperAdmin();
    }

    match /{clientId}/config/{collection}/{id} {
      allow read:  if isMember(clientId) || isSuperAdmin();
      allow write: if isMemberAdmin(clientId) || isSuperAdmin();
    }

    match /{clientId}/audit/logs/{id} {
      allow create: if isMember(clientId);
      allow read:   if isMemberAdmin(clientId);
      allow update, delete: if false;
    }

    match /{clientId}/{station}/reports/{id} {
      allow create: if isAuth();
      allow read:   if isMember(clientId);
      allow update: if isMember(clientId);
      allow delete: if isMemberAdmin(clientId);
    }

    match /{clientId}/{station}/tasks/{id} {
      allow read:   if isMember(clientId);
      allow create: if isMemberAdmin(clientId);
      allow update: if isMember(clientId);
      allow delete: if isMemberAdmin(clientId);
    }

    match /{clientId}/{station}/techs/{id} {
      allow read:  if isMember(clientId);
      allow write: if isMemberAdmin(clientId);
    }

    match /{clientId}/{station}/plans/{id} {
      allow read:   if isMember(clientId);
      allow create: if isMemberAdmin(clientId);
      allow update: if isMember(clientId);
      allow delete: if isMemberAdmin(clientId);
    }

    match /{clientId}/{station}/schedules/{id} {
      allow read:  if isMember(clientId);
      allow write: if isMemberAdmin(clientId);
    }

    match /{clientId}/{station}/flights/{id} {
      allow read:   if isMember(clientId);
      allow create: if isMemberAdmin(clientId);
      allow update: if isMember(clientId);
      allow delete: if isMemberAdmin(clientId);
    }

    match /{clientId}/{station}/config/{id} {
      allow read:  if isMember(clientId);
      allow write: if isMemberAdmin(clientId);
    }

    match /{clientId}/{station}/history/{id} {
      allow read, write: if isMember(clientId);
    }

    match /{clientId}/{station}/documents/{id} {
      allow read, write: if isMember(clientId);
    }

    // ════════════════════════════════════════════════════════════
    // BLOQUEO TOTAL — cualquier otra ruta: DENEGADA
    // ════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
